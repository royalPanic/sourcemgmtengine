# ==========================================
# 1. OSINT Case Manager App Files (Local Data)
# ==========================================
# Local SQLite databases, WAL journals and rollback journals
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite3

# Local user attachments / media evidence folders (dev-time only;
# the packaged app writes to the OS app-data directory instead)
/data/
/attachments/
/storage/
*.log

# ==========================================
# 2. Rust & Tauri Build Artifacts
# ==========================================
# Cargo build outputs
/src-tauri/target/

# Downloaded sidecars (fetched by `npm run fetch:yt-dlp`; never committed)
/src-tauri/binaries/

# Tauri generated code, schemas and capability manifests
/src-tauri/gen/

# NOTE: src-tauri/icons/* is intentionally NOT ignored. tauri.conf.json
# references these files for bundling, so they must be committed.

# NOTE: src-tauri/Cargo.lock IS committed on purpose. This is an
# application, not a library, so the lockfile pins reproducible builds.

# ==========================================
# 3. Node.js & React Frontend
# ==========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# Production frontend build outputs
/dist/
/dist-ssr/
/dist-isolation/
/build/
/.out/

# TypeScript incremental build info
*.tsbuildinfo

# Vite caches and temp files
/.vite/
/.cache/
vite.config.ts.timestamp-*
/coverage/

# Linter caches
.eslintcache
.stylelintcache

# ==========================================
# 4. Environment Variables
# ==========================================
# Ignore every local env file, but keep the documented template
.env
.env.*
!.env.example

# ==========================================
# 5. Editors & IDEs
# ==========================================
# VS Code: ignore local settings, keep shared workspace config
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# JetBrains
.idea/
*.iml

# Visual Studio
*.suo
*.user
*.userosscache
*.sln.docstates

# Vim / Emacs
*.swp
*.swo
*~
\#*\#
.\#*

# ==========================================
# 6. OS & System Junk
# ==========================================
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
.directory

# ==========================================
# 7. Merge / Patch Artifacts
# ==========================================
*.orig
*.rej
*.patch.bak